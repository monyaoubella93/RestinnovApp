# Production environment for docker-compose.prod.yml.
#
# HOW TO USE: copy this file to ".env" at the repo root (the same filename
# Laravel itself reads, and the one docker-compose.prod.yml's "db" service
# reads DB_*/DB_ROOT_PASSWORD from via variable substitution) -- NOT to
# ".env.production":
#
#   cp .env.production.example .env
#
# Then fill in every placeholder below (APP_KEY excepted -- see its comment)
# before running `docker compose -f docker-compose.prod.yml up --build -d`.
# See README-DEPLOY.md for the full walkthrough.
#
# Every password/secret below is a placeholder. Do not deploy with any of
# them left as-is -- generate real, unique values for each.

APP_NAME=RestInnov
APP_ENV=production
# Leave blank: the app container generates this itself on first start and
# writes it into this file (see docker/php/entrypoint.sh) -- exactly the
# same mechanism as the dev .env.example, just triggered by a missing key
# rather than a missing file. Do not set it by hand.
APP_KEY=
APP_DEBUG=false
# Replace with your real domain, matching the Caddyfile (https://, no
# trailing slash).
APP_URL=https://ton-domaine.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# "error" in production -- "debug" (the dev default) is far too verbose and
# can leak sensitive request data into logs.
LOG_LEVEL=error

# "db" is the MySQL service's hostname on the compose network (see
# docker-compose.prod.yml) -- leave as-is. DB_DATABASE/DB_USERNAME/
# DB_PASSWORD are read twice: directly by Laravel (via this file, bind-
# mounted into the app/scheduler containers) and by the "db" service itself
# (via ${DB_DATABASE} etc. substitution in docker-compose.prod.yml) to
# initialize MySQL with matching credentials -- change these three, and
# DB_ROOT_PASSWORD, to real generated passwords; they must stay in sync
# with nothing else, this file is their only source.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=restinnov
DB_USERNAME=restinnov
DB_PASSWORD=CHANGE_ME_db_password
# MySQL root password -- only used to initialize the "db" container; the
# app itself never uses the root account. No Laravel equivalent, but kept
# alongside the other DB_* settings since it's read the same way.
DB_ROOT_PASSWORD=CHANGE_ME_db_root_password

# Default manager account, created by ManagerAccountSeeder on first deploy.
# Change both before going live, and change the password again after first
# login (no in-app "change password" screen yet -- see README-DEPLOY.md).
MANAGER_DEFAULT_TELEPHONE=CHANGE_ME_phone_number
MANAGER_DEFAULT_PASSWORD=CHANGE_ME_manager_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookies only ever travel over HTTPS in production (Caddy terminates TLS
# in front of everything -- see Caddyfile).
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@ton-domaine.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
