# Multi-stage build: compiles the React/Vite frontend into static files,
# then bakes them into an nginx image that also proxies API requests to the
# "app" (PHP-FPM) service. This replaces the dev setup's separate
# long-running "frontend" Vite dev-server container -- in production there
# is no dev server, only a static build served by nginx.
#
# Built with the repo root as build context (see docker-compose.prod.yml),
# same convention as the existing dev frontend/Dockerfile.

FROM node:20-alpine AS frontend-build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .

# Left empty on purpose: an empty VITE_API_BASE_URL makes the frontend call
# the API with relative paths ("/api/..."), which resolve against whatever
# domain it's actually served from. Since nginx serves the frontend build
# AND proxies /api on the same origin (see default.prod.conf), this means
# the same image works behind any domain without needing to bake one in at
# build time -- no --build-arg needed for the common case.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

FROM nginx:alpine

COPY --from=frontend-build /app/dist /var/www/frontend-dist
COPY docker/nginx/conf.d/default.prod.conf /etc/nginx/conf.d/default.conf
