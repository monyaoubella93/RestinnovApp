# Multi-stage build: compiles the React/Vite frontend into static files,
# then bakes them into an nginx image that also proxies API requests to the
# "app" (PHP-FPM) service. This replaces the dev setup's separate
# long-running "frontend" Vite dev-server container -- in production there
# is no dev server, only a static build served by nginx.
#
# Built with the repo root as build context (see docker-compose.prod.yml),
# same convention as the existing dev frontend/Dockerfile.
#
# The built SPA is copied to /srv/frontend-dist, NOT /var/www/frontend-dist:
# the "nginx" service in docker-compose.prod.yml bind-mounts two host
# subdirectories under /var/www at container start (./public and
# ./storage/app/public -- see that file's comment on why it's narrower than
# the "app"/"scheduler" mount). A bind mount at /var/www/public or
# /var/www/storage/app/public only shadows that one path, but an earlier
# version of this mount was the whole repo (".:/var/www:ro"), which
# replaces the ENTIRE /var/www directory tree at runtime and would silently
# shadow anything baked into the image under /var/www -- including a
# frontend-dist placed there at build time. The build itself succeeds
# either way (this stage never touches /var/www), so the missing folder
# only shows up once the container is actually running. Keeping the SPA
# under /srv sidesteps that risk entirely, regardless of how /var/www ends
# up mounted.

FROM node:20-alpine AS frontend-build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .

# Left empty on purpose: an empty VITE_API_BASE_URL makes the frontend call
# the API with relative paths ("/api/..."), which resolve against whatever
# domain it's actually served from. Since nginx serves the frontend build
# AND proxies /api on the same origin (see default.prod.conf), this means
# the same image works behind any domain without needing to bake one in at
# build time -- no --build-arg needed for the common case.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

FROM nginx:alpine

COPY --from=frontend-build /app/dist /srv/frontend-dist
COPY docker/nginx/conf.d/default.prod.conf /etc/nginx/conf.d/default.conf
